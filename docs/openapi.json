  "components": {
    "schemas": {
      "Body_ingest_image_documents_image_post": {
        "properties": {
          "patient_id": {
            "type": "string",
            "pattern": "^SYN-[A-Za-z0-9-]{1,40}$",
            "title": "Patient Id"
          },
          "file": {
            "type": "string",
            "contentMediaType": "application/octet-stream",
            "title": "File"
          }
        },
        "type": "object",
        "required": [
          "patient_id",
          "file"
        ],
        "title": "Body_ingest_image_documents_image_post"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Measurement": {
        "properties": {
          "name": {
            "type": "string",
            "enum": [
              "Hemoglobin",
              "Glucose",
              "WBC"
            ],
            "title": "Name"
          },
          "value": {
            "type": "number",
            "maximum": 1000000.0,
            "minimum": 0.0,
            "title": "Value"
          },
          "unit": {
            "type": "string",
            "maxLength": 24,
            "minLength": 1,
            "title": "Unit"
          },
          "reference_low": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Reference Low"
          },
          "reference_high": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Reference High"
          },
          "source_line": {
            "type": "string",
            "maxLength": 500,
            "minLength": 1,
            "title": "Source Line"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "name",
          "value",
          "unit",
          "reference_low",
          "reference_high",
          "source_line"
        ],
        "title": "Measurement"
      },
      "Review": {
        "properties": {
          "expected_revision": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Expected Revision"
          },
          "acknowledge_unparsed": {
            "type": "boolean",
            "title": "Acknowledge Unparsed",
            "default": false
          },
          "decision": {
            "type": "string",
            "enum": [
              "approve",
              "reject"
            ],
            "title": "Decision"
          },
          "measurements": {
            "anyOf": [
              {
                "items": {
                  "$ref": "#/components/schemas/Measurement"
                },
                "type": "array",
                "maxItems": 30
              },
              {
                "type": "null"
              }
            ],
            "title": "Measurements"
          },
          "note": {
            "type": "string",
            "maxLength": 1000,
            "minLength": 3,
            "title": "Note"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "expected_revision",
          "decision",
          "note"
        ],
        "title": "Review"
      },
      "TextDocument": {
        "properties": {
          "patient_id": {
            "type": "string",
            "pattern": "^SYN-[A-Za-z0-9-]{1,40}$",
            "title": "Patient Id"
          },
          "text": {
            "type": "string",
            "maxLength": 20000,
            "minLength": 1,
            "title": "Text"
          },
          "synthetic": {
            "type": "boolean",
            "const": true,
            "title": "Synthetic"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "patient_id",
          "text",
          "synthetic"
        ],
        "title": "TextDocument"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  }
}
